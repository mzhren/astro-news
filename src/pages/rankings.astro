---
import ListLayout from "@/layouts/list.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("views", "rankings");

if (!entry) {
  return Astro.redirect("/404");
}

type BoardCell = string | number | { text: string; href: string };

type Board = {
  id: string;
  emoji: string;
  title: string;
  description: string;
  columns: string[];
  rows: BoardCell[][];
};

const boards: Board[] = [
  {
    id: "models",
    emoji: "🧠",
    title: "模型榜",
    description: "主流大模型综合能力横评（示例数据）",
    columns: ["排名", "模型", "厂商", "综合分", "环比", "开源"],
    rows: [
      [1, "GPT-5.2", "OpenAI", 94.2, "▲ 1.3", "否"],
      [2, "Claude 4.5 Opus", "Anthropic", 93.5, "▲ 2.1", "否"],
      [3, "Gemini 3 Ultra", "Google", 92.8, "▲ 0.8", "否"],
      [4, "DeepSeek-V4", "DeepSeek", 92.1, "▲ 3.4", "是"],
      [5, "Qwen 4 Max", "阿里", 91.4, "▲ 1.9", "是"],
      [6, "Kimi K2", "月之暗面", 90.2, "▲ 2.7", "是"],
      [7, "GLM-5", "智谱", 89.6, "▲ 1.1", "是"],
      [8, "Llama 4 405B", "Meta", 88.9, "▼ 0.4", "是"],
    ],
  },
  {
    id: "products",
    emoji: "🚀",
    title: "产品榜",
    description: "Product Hunt 每日榜 · 2026-11-09（初榜 · 采集中）",
    columns: ["排名", "产品", "一句话介绍", "分类", "票数"],
    rows: [
      [1, { text: "Product Hunt MCP", href: "https://www.producthunt.com/products/producthunt" }, "在你常用的 AI 助手里接入可信的 Product Hunt 社区数据", "效率 / 开发工具 / AI", 301],
      [2, { text: "Dageno AI 2.0", href: "https://www.producthunt.com/products/agent-powered-geo-by-dageno" }, "看看 AI 为什么推荐你的竞品而不是你", "营销 / SEO / 搜索", 286],
      [3, { text: "Databox CLI", href: "https://www.producthunt.com/products/databox" }, "终端里的智能体分析平台", "效率 / SaaS / 开发工具", 261],
      [4, { text: "Arcjet AI security models", href: "https://www.producthunt.com/products/arcjet" }, "为 coding agent 定制的安全模型家族", "开发工具 / AI / 安全", 199],
      [5, { text: "ProtoMap", href: "https://www.producthunt.com/products/hounddog-ai-static-code-scanner-2" }, "别再浪费 AI token 重复发现依赖", "开发工具 / AI / GitHub", 152],
      [6, { text: "Higgsfield Miracle", href: "https://www.producthunt.com/products/higgsfield" }, "只改视频局部，其余画面保持不变", "设计工具 / AI / 视频", 122],
      [7, { text: "MCP1", href: "https://www.producthunt.com/products/appwrite" }, "一个 URL 汇聚所有 MCP 服务器", "API / 开发工具 / AI", 119],
      [8, { text: "GitHub New PR Overview", href: "https://www.producthunt.com/products/github" }, "滚动之前先看清 PR 被什么阻塞", "开发工具 / GitHub", 119],
      [9, { text: "Voyager ✴️", href: "https://www.producthunt.com/products/vygr" }, "浏览工作上下文的智能体文件管理器", "效率 / 开发工具 / AI", 102],
      [10, { text: "Pawse.ai", href: "https://www.producthunt.com/products/pawse-ai" }, "为狗而非人设计的声效工程", "Android / iOS / 宠物", 101],
    ],
  },
];
---

<ListLayout header="榜单" entry={entry}>
  <nav class="flex gap-2 my-4" aria-label="榜单导航">
    {
      boards.map((board) => (
        <a href={`#${board.id}`} class="btn btn-sm btn-outline">
          {board.emoji} {board.title}
        </a>
      ))
    }
  </nav>

  <div class="flex flex-col gap-12 my-6">
    {
      boards.map((board) => (
        <section id={board.id} class="scroll-mt-24 flex flex-col gap-4">
          <div>
            <h2 class="text-xl font-bold flex items-center gap-2">
              <span aria-hidden="true">{board.emoji}</span>
              {board.title}
            </h2>
            <p class="text-sm text-base-content/60">{board.description}</p>
          </div>
          <div class="overflow-x-auto rounded-lg border border-base-300">
            <table class="table">
              <thead>
                <tr>
                  {board.columns.map((column) => (
                    <th>{column}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {board.rows.map((row) => (
                  <tr class="hover:bg-base-200/60">
                    {row.map((cell, i) => (
                      <td
                        class:list={[
                          i === 0 && "font-bold",
                          i === 1 && "font-semibold",
                          typeof cell === "string" && cell.startsWith("▲") &&
                            "text-success",
                          typeof cell === "string" && cell.startsWith("▼") &&
                            "text-error",
                        ]}
                      >
                        {i === 0 && typeof cell === "number" && cell < 4 ? (
                          <span class="inline-flex w-6 h-6 items-center justify-center rounded-full bg-primary/10 text-primary dark:text-secondary">
                            {cell}
                          </span>
                        ) : typeof cell === "object" && cell !== null ? (
                          <a
                            href={cell.href}
                            target="_blank"
                            rel="noopener"
                            class="link link-hover link-primary"
                          >
                            {cell.text}
                          </a>
                        ) : (
                          cell
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }
  </div>

  <p class="text-xs text-base-content/50 pb-4">
    产品榜数据来源：Product Hunt 每日榜 · 2026-11-09（初榜 · 采集中），经 AIGCNEWS（aigcnews.cn）聚合，抓取于 2026-11-10，票数持续更新；模型榜为演示数据。
  </p>
</ListLayout>
