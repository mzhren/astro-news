---
import ArrowRight02 from "@/assets/svgs/arrow-right-02.astro";

const boards = [
  {
    id: "models",
    emoji: "🧠",
    title: "模型榜",
    description: "主流大模型能力横评：推理、代码、中文理解与性价比排名。",
  },
  {
    id: "products",
    emoji: "🚀",
    title: "产品榜",
    description: "AI 应用热度榜：用户规模、增长曲线与口碑评分。",
  },
];
---

<section class="container pt-12 space-y-4" data-pagefind-ignore="all">
  <div class="flex items-center gap-2">
    <h2 class="text-xl font-bold">榜单</h2>
    <a
      href="/rankings"
      class="ml-auto group flex text-sm items-center gap-1 text-base-content/80 hover:gap-2 transition-all duration-200"
    >
      <span class="group-hover:text-primary">进入榜单</span>
      <span
        class="group-hover:translate-x-0.5 transition-transform group-hover:text-primary"
      >
        <ArrowRight02 size="16" />
      </span>
    </a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      boards.map((board) => (
        <a
          href={`/rankings#${board.id}`}
          class="group card bg-base-200/50 border border-base-300 hover:border-primary/40 transition-colors"
        >
          <div class="card-body flex-row items-center gap-4">
            <span class="text-4xl" aria-hidden="true">
              {board.emoji}
            </span>
            <div class="flex-1">
              <h3 class="card-title text-lg">{board.title}</h3>
              <p class="text-sm text-base-content/70">{board.description}</p>
            </div>
            <span class="group-hover:translate-x-1 transition-transform text-base-content/40">
              <ArrowRight02 size="20" />
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>
