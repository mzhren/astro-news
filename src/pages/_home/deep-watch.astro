---
import { articlesHandler } from "@/lib/handlers/articles";
import { getDateDistance, normalizeDate } from "@/lib/utils/date";

const articles = articlesHandler.deepWatch(3);
---

<section class="flex flex-col gap-4" data-pagefind-ignore="all">
  <div class="flex items-center gap-2">
    <h2 class="text-xl font-bold">深度观察</h2>
    <span class="badge badge-outline badge-sm">观点</span>
    <a
      href="/deep-watch"
      class="ml-auto text-sm text-base-content/80 hover:text-primary transition-all"
      >查看全部</a
    >
  </div>
  <ol class="flex flex-col divide-y divide-base-300">
    {
      articles.map((article, index) => (
        <li class="group relative isolate py-3 first:pt-0">
          <div class="flex items-start gap-3">
            <span class="font-serif text-2xl font-bold text-primary/40 dark:text-secondary/40 leading-none pt-0.5">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="flex-1 flex flex-col gap-1.5">
              <h3 class="font-serif font-semibold leading-snug lg:group-hover:underline underline-offset-2">
                <a href={`/articles/${article.id}`}>
                  <span class="absolute inset-0 z-10 pointer-events-none" />
                  {article.data.title}
                </a>
              </h3>
              <p class="text-sm text-base-content/80 line-clamp-2 text-pretty">
                {article.data.description}
              </p>
              {article.data.editorNote && (
                <p class="text-sm text-base-content/70 border-l-2 border-primary/60 dark:border-secondary/60 pl-3 italic">
                  <span class="not-italic font-semibold text-primary dark:text-secondary">
                    观点：
                  </span>
                  {article.data.editorNote}
                </p>
              )}
              <time
                class="text-xs text-base-content/60"
                datetime={normalizeDate(article.data.publishedTime)}
              >
                {getDateDistance(normalizeDate(article.data.publishedTime))}
              </time>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>
