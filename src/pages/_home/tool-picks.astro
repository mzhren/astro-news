---
import NewsCard from "@/components/cards/newsCard.astro";
import { articlesHandler } from "@/lib/handlers/articles";
import ArrowRight02 from "@/assets/svgs/arrow-right-02.astro";

const tools = articlesHandler.byCategory("tools").slice(0, 4);
---

{
  tools.length > 0 && (
    <section class="container pt-12 space-y-4" data-pagefind-ignore="all">
      <div class="flex items-center gap-2">
        <h2 class="text-xl font-bold">工具推荐</h2>
        <span class="badge badge-outline badge-sm">每周精选</span>
        <a
          href="/categories/tools"
          class="ml-auto group flex text-sm items-center gap-1 text-base-content/80 hover:gap-2 transition-all duration-200"
        >
          <span class="group-hover:text-primary">查看全部</span>
          <span class="group-hover:translate-x-0.5 transition-transform group-hover:text-primary">
            <ArrowRight02 size="16" />
          </span>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 gap-y-6">
        {tools.map((article, index) => (
          <NewsCard article={article} index={index} />
        ))}
      </div>
    </section>
  )
}
